# Copy to .env (kept out of git) and fill in only the providers you signed up for.
# LLM picks the writer, LLM_JUDGE the stance judge (default: the writer's model at temperature 0).
# Several specs joined by commas fall back in order, e.g. LLM=groq:llama-3.3-70b-versatile,ollama:llama3.1:8b
LLM=ollama:llama3.1:8b
LLM_JUDGE=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
# The organisers' LLM, once they publish it: use LLM=official:<model>
CTN_LLM_URL=
CTN_LLM_KEY=
# The team's competition bot key from the community portal, and the API address if it moved from 2025's
CTN_BOT_KEY=
CTN_API_URL=
